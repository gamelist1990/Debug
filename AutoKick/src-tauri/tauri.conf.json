{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoKick",
  "version": "0.1.0",
  "identifier": "com.autokick.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AutoKick Control Center", "width": 1280, "height": 900, "minWidth": 1050, "minHeight": 720 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../.tauri-bundle/node-runtime": "node-runtime",
      "../.tauri-bundle/backend": "backend"
    }
  }
}
